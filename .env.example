# Copy to .env.local; never commit real credentials.
DATABASE_URL=postgresql://formfisik:change-me@127.0.0.1:5432/formfisik
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
ABUSE_HMAC_SECRET=
SMTP_HOST=127.0.0.1
MAIL_TRANSPORT=smtp
RESEND_API_KEY=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FormFisik <no-reply@example.com>
# Leave empty unless the ingress overwrites this header with ONE validated IP.
# Without it, per-IP limiting conservatively shares an ingress bucket.
TRUSTED_CLIENT_IP_HEADER=
# Login and sessions require DATABASE_URL, APP_URL and ABUSE_HMAC_SECRET.
# SMTP is required by registration/email verification and password recovery.
# Production uses HTTPS + __Host-formfisik-session (Secure, HttpOnly, SameSite=Lax).
# Session policy: 30 minutes idle, 12 hours absolute; not configurable via client.

# Recovery uses APP_URL + /redefinir-senha#token, 30-minute one-time links.
# Disable provider click tracking/analytics for these sensitive links.

# SaaS billing: local test by default; hosted deployments require explicit mode/account.
# staging + https://sta.formfisik.com.br -> test; production + https://formfisik.com.br -> live.
# disabled prevents payment operations. Never publish credentials or share databases across modes.
STRIPE_BILLING_MODE=test
STRIPE_ACCOUNT_ID=
# Secret/restricted key must match the selected mode. Hosted runtime also verifies account identity.
STRIPE_SECRET_KEY=
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=
# Local: signing secret from YOUR stripe listen. Hosted: its own endpoint signing secret.
STRIPE_WEBHOOK_SECRET=
# Mode, deployment, origin, key and catalog must agree before checkout is available.

# Active Portal configuration from the same mode/account, card/invoices enabled,
# subscription_update and subscription_cancel disabled (cancellation is in FormFisik).
STRIPE_PORTAL_CONFIGURATION_ID=

# Delivery 013: private Cloudflare R2 photos, server-only. Leave blank until configured.
# No public bucket, public URL, production disk fallback or real credentials here.
R2_ACCOUNT_ID=
R2_PHOTOS_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# See docs/operacao/fotografias-r2.md; presence is not external homologation.

# Settings CPF encryption: independent 32-byte AES-256 key, 64 hexadecimal characters.
# Server only; keep in the environment secret store. Back up securely; never rotate without re-encryption.
SETTINGS_ENCRYPTION_KEY=

# Multi-plan SaaS catalog from the selected mode. Pro monthly aliases remain supported.
STRIPE_PRODUCT_STANDARD=
STRIPE_PRODUCT_PREMIUM=
STRIPE_PRODUCT_PRO=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# eCoach API integration. Disabled until provider/model, data review and credentials are configured.
ECOACH_AI_ENABLED=false
ECOACH_AI_PROVIDER=openai
ECOACH_AI_MODEL=
ECOACH_OPENAI_API_KEY=
ECOACH_ANTHROPIC_API_KEY=
ECOACH_AI_DATA_APPROVED=false
ECOACH_AI_DAILY_LIMIT=20
ECOACH_AI_GLOBAL_DAILY_LIMIT=200
# Chamadas reais compartilhadas entre chat, ferramentas, atendimento e mídia (janela de 24h).
ECOACH_AI_CALL_DAILY_LIMIT=30
ECOACH_AI_CALL_GLOBAL_DAILY_LIMIT=300
ECOACH_AI_MAX_OUTPUT_TOKENS=4096

# Optional audio transcription model (server only); consent renewed when changed.
ECOACH_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Railway production stays in maintenance unless explicitly released. Not a billing/authorization bypass.
PRODUCTION_RELEASE_STATE=closed
