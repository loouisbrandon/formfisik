# Copy to .env.local; never commit real credentials.
DATABASE_URL=postgresql://formfisik:change-me@127.0.0.1:5432/formfisik
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
ABUSE_HMAC_SECRET=
SMTP_HOST=127.0.0.1
MAIL_TRANSPORT=smtp
RESEND_API_KEY=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FormFisik <no-reply@example.com>
# Leave empty unless the ingress overwrites this header with ONE validated IP.
# Without it, per-IP limiting conservatively shares an ingress bucket.
TRUSTED_CLIENT_IP_HEADER=
# Login and sessions require DATABASE_URL, APP_URL and ABUSE_HMAC_SECRET.
# SMTP is required by registration/email verification and password recovery.
# Production uses HTTPS + __Host-formfisik-session (Secure, HttpOnly, SameSite=Lax).
# Session policy: 30 minutes idle, 12 hours absolute; not configurable via client.

# Recovery uses APP_URL + /redefinir-senha#token, 30-minute one-time links.
# Disable provider click tracking/analytics for these sensitive links.

# Delivery 005: LOCAL Stripe test mode only. Leave blank until configured.
# Never use sk_live_, publish secret keys, or commit .env.local.
# Product must be active; price BRL 13990 cents, monthly, quantity 1.
STRIPE_SECRET_KEY=
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID=
# Signing secret from YOUR local `stripe listen` process (whsec_...).
STRIPE_WEBHOOK_SECRET=
# All four settings + localhost APP_URL are required to enable test checkout.

# Delivery 006: active TEST Portal configuration, card/invoices enabled,
# subscription_update and subscription_cancel disabled (cancellation is in FormFisik).
STRIPE_PORTAL_CONFIGURATION_ID=

# Delivery 013: private Cloudflare R2 photos, server-only. Leave blank until configured.
# No public bucket, public URL, production disk fallback or real credentials here.
R2_ACCOUNT_ID=
R2_PHOTOS_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# See docs/operacao/fotografias-r2.md; presence is not external homologation.

# Settings CPF encryption: independent 32-byte AES-256 key, 64 hexadecimal characters.
# Server only; keep in the environment secret store. Back up securely; never rotate without re-encryption.
SETTINGS_ENCRYPTION_KEY=

# Multi-plan SaaS catalog (TEST only). Existing Pro monthly aliases above remain supported.
STRIPE_PRODUCT_STANDARD=
STRIPE_PRODUCT_PREMIUM=
STRIPE_PRODUCT_PRO=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
