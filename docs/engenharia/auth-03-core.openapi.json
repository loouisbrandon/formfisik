  "openapi": "3.1.0",
  "info": {
    "title": "FormFisik Core Personal Registration \u2014 AUTH-03",
    "version": "1.0.0",
    "description": "Local AUTH03 implementation under isolated validation. NO-GO015 preserved. Migration043 applied only in synthetic loopback test databases. No official legal text or external email. Responses bounded to65536 UTF8 bytes after JSON serialization; legal documents <=12288 UTF8 bytes each."
  },
