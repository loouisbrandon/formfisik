{
  "openapi": "3.1.0",
  "info": {
    "title": "FormFisik Core Mobile Auth",
    "version": "1.0.0",
    "description": "Local implementation; no production/iOS homologation. Canonical users.id; opaque user tokens, direct ES256 service assertion."
  },
  "paths": {
    "/api/core/v1/mobile-auth/login": {
      "post": {
        "operationId": "mobileAuthLogin",
        "description": "Exact service assertion scope core:mobile-auth:login. Login/choice operationId does not guarantee retry; refresh requires persistent retrySecret. No Origin spoofing.",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Controlled error; service_* codes are integration failures, not user auth failures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Controlled error; service_* codes are integration failures, not user auth failures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Controlled error; service_* codes are integration failures, not user auth failures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Controlled error; service_* codes are integration failures, not user auth failures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Controlled error; service_* codes are integration failures, not user auth failures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Restricted challenge; no full session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionLimit"
                }
              }
            }
          }
        }
      }
    },
