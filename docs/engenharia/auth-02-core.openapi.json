  "components": {
    "securitySchemes": {
      "serviceAssertion": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "installationId": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "platform": {
            "enum": [
              "android",
              "ios"
            ]
          }
        },
        "required": [
          "installationId",
          "label",
          "platform"
        ]
      },
      "Identity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "AUTH02 technical capabilities only; not a full commercial/domain authorization projection"
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "role",
          "capabilities"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          },
          "refreshToken": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresIn": {
            "const": 300
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "sessionId",
          "expiresIn",
          "identity"
        ]
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "email",
          "password",
          "device",
          "operationId"
        ]
      },
      "Refresh": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "refreshToken": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "retrySecret": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          }
        },
        "required": [
          "refreshToken",
          "operationId",
          "retrySecret"
        ]
      },
      "Inspect": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          },
          "interaction": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "Logout": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accessToken": {
                "type": "string",
                "pattern": "^[\\w-]{43}$"
              }
            },
            "required": [
              "accessToken"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "refreshToken": {
                "type": "string",
                "pattern": "^[\\w-]{43}$"
              }
            },
            "required": [
              "refreshToken"
            ]
          }
        ]
      },
      "Choice": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "challengeToken": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          },
          "revokeSessionId": {
            "type": "string",
            "format": "uuid"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "challengeToken",
          "revokeSessionId",
          "operationId"
        ]
      },
      "SessionLimit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "const": "session_limit"
              }
            },
            "required": [
              "code"
            ]
          },
          "challengeToken": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          },
          "sessions": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "kind": {
                  "enum": [
                    "web",
                    "mobile"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "lastRelevantAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "kind",
                "label",
                "lastRelevantAt"
              ]
            }
          }
        },
        "required": [
          "error",
          "challengeToken",
          "sessions"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      }
    }
  }
}