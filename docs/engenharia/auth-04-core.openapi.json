{
  "openapi": "3.1.0",
  "info": {
    "title": "FormFisik Core Recovery AUTH04",
    "version": "1.0.0",
    "description": "Local implementation in progress, no production/iOS homologation. Reuses Web recovery token/link and all-session revocation. Development-only handoff formfisik-dev://redefinir-senha#token; Web fallback APP_URL/redefinir-senha#token."
  },
  "paths": {
    "/api/core/v1/recovery/request": {
      "post": {
        "operationId": "coreRecoveryRequest",
        "description": "Exact scope core:recovery:request. JSON <=8192 bytes, no token in URL, no automatic retries of mutations.",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Generic acceptance, not delivery/account proof",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/core/v1/recovery/validate": {
      "post": {
        "operationId": "coreRecoveryValidate",
        "description": "Exact scope core:recovery:validate. JSON <=8192 bytes, no token in URL, no automatic retries of mutations.",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Validate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated result; never authenticates automatically",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "valid": {
                      "const": true
                    }
                  },
                  "required": [
                    "valid"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/core/v1/recovery/reset": {
      "post": {
        "operationId": "coreRecoveryReset",
        "description": "Exact scope core:recovery:reset. JSON <=8192 bytes, no token in URL, no automatic retries of mutations.",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reset"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated result; never authenticates automatically",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "reset": {
                      "const": true
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "reset",
                    "message"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Controlled failure. service_* means integration failure, not user credential failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceAssertion": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "Validate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          }
        },
        "required": [
          "token"
        ]
      },
      "Reset": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Canonical policy: uppercase/lowercase Unicode and non-whitespace special; no trim"
          },
          "confirmPassword": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "password",
          "confirmPassword"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "invalid_request",
                  "invalid_reset_token",
                  "rate_limited",
                  "dependency_unavailable",
                  "service_unauthorized",
                  "service_forbidden",
                  "service_replay",
                  "service_unavailable",
                  "service_rate_limited"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      }
    }
  }
}